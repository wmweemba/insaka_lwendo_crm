# Copy to .env.local for dev, or set directly in Coolify env vars for deploy.
# Never commit a file with real values — see .gitignore / .dockerignore.

DATABASE_URL="postgresql://user:password@localhost:5432/insaka_lwendo_crm"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Inbound integration secrets — one per emitting app, named INGEST_SECRET_<APP>
# (see src/lib/ingestAuth.ts — the key is derived from the "app" field in the
# webhook payload, uppercased). Add a new line here as each app's emitter is
# wired up; no code change needed, just a new env var. See
# docs/planning/02-capture-and-integrations.md §3/§5.
# INGEST_SECRET_BAZABOOKS=""
# INGEST_SECRET_CHAMA360=""

# Agent API — one bearer key per assistant, named AGENT_API_KEY_<NAME>
# (see src/lib/agentAuth.ts). Generate with `openssl rand -hex 32`. Only
# assistants with a key configured here can authenticate — nothing else to
# wire up per caller. See CLAUDE.md's "Agent API" section.
# AGENT_API_KEY_CLAUDE=""
# AGENT_API_KEY_HERMES=""
# AGENT_API_KEY_ZEROCLAW=""
